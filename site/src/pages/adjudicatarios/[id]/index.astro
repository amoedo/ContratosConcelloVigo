---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs';
import PageHero from '@/components/layout/PageHero.astro';
import { EChart } from '@/components/charts/EChart';
import { AlertList } from '@/components/sections/AlertList';
import { RecordsTable } from '@/components/sections/RecordsTable';
import { formatCurrency, formatNumber, formatPercent } from '@/lib/format';
import { withBase } from '@/lib/base';
import { loadDerivedJson } from '@/lib/loadData';
import { createEmptyEntityDetail, type EntityDetail, type EntityIndexItem } from '@/lib/types';

export async function getStaticPaths() {
  const items = await loadDerivedJson<EntityIndexItem[]>('entities/vendors/index.json', []);
  return items.map((item) => ({ params: { id: item.id } }));
}

const id = Astro.params.id ?? '';
const detail = await loadDerivedJson<EntityDetail>(`entities/vendors/${id}.json`, createEmptyEntityDetail(id, 'vendor', 'Adjudicatario sin datos'));

const yearlyOption = {
  tooltip: { trigger: 'axis' },
  xAxis: { type: 'category', data: detail.timeseries.yearly.map((item) => item.key) },
  yAxis: [{ type: 'value' }, { type: 'value' }],
  series: [
    { type: 'bar', data: detail.timeseries.yearly.map((item) => item.amount), itemStyle: { color: '#005f73' } },
    { type: 'line', yAxisIndex: 1, smooth: true, data: detail.timeseries.yearly.map((item) => item.count), itemStyle: { color: '#bb3e03' } },
  ],
};

const counterpartyOption = {
  tooltip: { trigger: 'axis' },
  grid: { left: 20, right: 20, bottom: 20, containLabel: true },
  xAxis: { type: 'value' },
  yAxis: { type: 'category', data: detail.top_counterparties.slice(0, 10).map((item) => item.name), inverse: true },
  series: [{ type: 'bar', data: detail.top_counterparties.slice(0, 10).map((item) => item.amount), itemStyle: { color: '#7c6a0a' } }],
};
---
<BaseLayout title={`${detail.entity_name} | Adjudicatarios`} titleGl={`${detail.entity_name} | Adxudicatarios`} description={`Ficha del adjudicatario ${detail.entity_name}.`} descriptionGl={`Ficha do adxudicatario ${detail.entity_name}.`}>
  <Breadcrumbs client:load items={[{ label: 'Adjudicatarios', labelGl: 'Adxudicatarios', href: '/adjudicatarios' }, { label: detail.entity_name }]} />
  <PageHero eyebrow="Ficha de adjudicatario" eyebrowGl="Ficha de adxudicatario" title={detail.entity_name} copy="Resumen agregado, evolución, unidades con las que trabaja y alertas relacionadas con este proveedor." copyGl="Resumo agregado, evolución, unidades coas que traballa e alertas relacionadas con este provedor." />

  <section class="grid metrics section">
    <article class="stat-card"><span>Importe total</span><strong>{formatCurrency(detail.totals.total_amount)}</strong></article>
    <article class="stat-card"><span><span data-lang="es">Adjudicaciones</span><span data-lang="gl">Adxudicacións</span></span><strong>{formatNumber(detail.totals.contract_count)}</strong></article>
    <article class="stat-card"><span><span data-lang="es">Importe medio</span><span data-lang="gl">Importe medio</span></span><strong>{formatCurrency(detail.totals.mean_amount)}</strong></article>
    <article class="stat-card"><span>% un licitador</span><strong>{formatPercent(detail.competition.single_bidder_pct)}</strong></article>
    <article class="stat-card"><span><span data-lang="es">Posición por importe</span><span data-lang="gl">Posición por importe</span></span><strong>#{formatNumber(detail.rank ?? 0)}</strong></article>
    <article class="stat-card"><span><span data-lang="es">Cuota del importe total</span><span data-lang="gl">Cota do importe total</span></span><strong>{formatPercent((detail.share_of_total ?? 0) * 100)}</strong></article>
  </section>

  <section class="profile-context panel section">
    <div><span class="kicker">Contexto</span><h2 class="card-title"><span data-lang="es">Actividad y comparables</span><span data-lang="gl">Actividade e comparables</span></h2><p><span data-lang="es">Aparece en {detail.totals.years.join(', ')}. La competencia se calcula sobre {formatNumber(detail.totals.known_competition_count)} registros con dato válido.</span><span data-lang="gl">Aparece en {detail.totals.years.join(', ')}. A competencia calcúlase sobre {formatNumber(detail.totals.known_competition_count)} rexistros con dato válido.</span></p><div class="badge-row">{detail.topics.slice(0, 6).map((topic) => <span class="badge">{topic.label} · {topic.count}</span>)}</div></div>
    <div><h3><span data-lang="es">Perfiles cercanos en el ranking</span><span data-lang="gl">Perfís próximos no ranking</span></h3><ul class="peer-list">{detail.comparable_peers?.map((peer) => <li><a href={withBase(`/adjudicatarios/${peer.id}`)}>{peer.name}</a><strong>{formatCurrency(peer.total_amount)}</strong></li>)}</ul></div>
    <a class="pill-link pill-link--accent" href={`${withBase('/explorador')}?vendor=${detail.entity_id}`}><span data-lang="es">Ver todas las filas de este adjudicatario</span><span data-lang="gl">Ver todas as filas deste adxudicatario</span></a>
  </section>

  <section class="two-col section">
    <div class="chart-card panel">
      <h3 class="card-title"><span data-lang="es">Evolución anual</span><span data-lang="gl">Evolución anual</span></h3>
      <EChart client:visible option={yearlyOption} height={360} />
    </div>
    <div class="chart-card panel">
      <h3 class="card-title"><span data-lang="es">Unidades con las que más trabaja</span><span data-lang="gl">Unidades coas que máis traballa</span></h3>
      <EChart client:visible option={counterpartyOption} height={360} />
    </div>
  </section>

  <section class="two-col section">
    <AlertList client:load alerts={detail.pattern_clusters} title="Alertas vinculadas" titleGl="Alertas vinculadas" />
    <RecordsTable client:load rows={detail.near_threshold_records} title="Casos cercanos al umbral" titleGl="Casos preto do limiar" />
  </section>

  <section class="section">
    <RecordsTable client:load rows={detail.recent_records} title="Registros recientes" titleGl="Rexistros recentes" />
  </section>
</BaseLayout>
