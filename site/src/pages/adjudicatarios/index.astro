---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import { YearlyAnalysis } from '@/components/sections/YearlyAnalysis';
import { loadDerivedJson } from '@/lib/loadData';
import { EMPTY_META, EMPTY_VENDORS_PAGE, type MetaData, type VendorsPageData } from '@/lib/types';
const data = await loadDerivedJson<VendorsPageData>('vendors.json', EMPTY_VENDORS_PAGE);
const meta = await loadDerivedJson<MetaData>('meta.json', EMPTY_META);
---
<BaseLayout title="Adjudicatarios | Contratos de Vigo" titleGl="Adxudicatarios | Contratos de Vigo" description="Rankings y concentración de adjudicatarios de contratos menores de Vigo." descriptionGl="Rankings e concentración de adxudicatarios de contratos menores de Vigo.">
  <PageHero eyebrow="Análisis por adjudicatario" eyebrowGl="Análise por adxudicatario" title="Quién recibe más y cuánto concentra" titleGl="Quen recibe máis e canto concentra" copy="Cambia de ejercicio para comparar proveedores con una base homogénea y abre cada ficha para verificar su actividad." copyGl="Cambia de exercicio para comparar provedores cunha base homoxénea e abre cada ficha para verificar a súa actividade." />
  <YearlyAnalysis client:load section="vendors" initial={data} meta={meta} />
</BaseLayout>
