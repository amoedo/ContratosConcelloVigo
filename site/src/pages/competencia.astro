---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import { YearlyAnalysis } from '@/components/sections/YearlyAnalysis';
import { loadDerivedJson } from '@/lib/loadData';
import { EMPTY_COMPETITION_PAGE, EMPTY_META, type CompetitionPageData, type MetaData } from '@/lib/types';
const data = await loadDerivedJson<CompetitionPageData>('competition.json', EMPTY_COMPETITION_PAGE);
const meta = await loadDerivedJson<MetaData>('meta.json', EMPTY_META);
---
<BaseLayout title="Competencia | Contratos de Vigo" titleGl="Competencia | Contratos de Vigo" description="Número de licitadores y competencia en contratos menores de Vigo." descriptionGl="Número de licitadores e competencia nos contratos menores de Vigo.">
  <PageHero eyebrow="Competencia" eyebrowGl="Competencia" title="Dónde hay más y menos concurrencia" titleGl="Onde hai máis e menos concorrencia" copy="Los porcentajes se calculan sobre registros con un número de licitadores válido; el denominador siempre se muestra." copyGl="As porcentaxes calcúlanse sobre rexistros cun número de licitadores válido; o denominador móstrase sempre." />
  <YearlyAnalysis client:load section="competition" initial={data} meta={meta} />
</BaseLayout>
