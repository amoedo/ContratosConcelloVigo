---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import { YearlyAnalysis } from '@/components/sections/YearlyAnalysis';
import { loadDerivedJson } from '@/lib/loadData';
import { EMPTY_META, EMPTY_TIMELINE_PAGE, type MetaData, type TimelinePageData } from '@/lib/types';
const data = await loadDerivedJson<TimelinePageData>('timeline.json', EMPTY_TIMELINE_PAGE);
const meta = await loadDerivedJson<MetaData>('meta.json', EMPTY_META);
---
<BaseLayout title="Evolución | Contratos de Vigo" titleGl="Evolución | Contratos de Vigo" description="Evolución mensual y anual de la contratación menor de Vigo." descriptionGl="Evolución mensual e anual da contratación menor de Vigo.">
  <PageHero eyebrow="Evolución temporal" eyebrowGl="Evolución temporal" title="Cambios de ritmo, picos y ejercicios atípicos" titleGl="Cambios de ritmo, picos e exercicios atípicos" copy="Selecciona un ejercicio para ver su patrón mensual o usa la serie completa para comparar años." copyGl="Selecciona un exercicio para ver o seu patrón mensual ou usa a serie completa para comparar anos." />
  <YearlyAnalysis client:load section="timeline" initial={data} meta={meta} />
</BaseLayout>
