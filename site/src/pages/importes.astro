---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import { YearlyAnalysis } from '@/components/sections/YearlyAnalysis';
import { loadDerivedJson } from '@/lib/loadData';
import { EMPTY_AMOUNTS_PAGE, EMPTY_META, type AmountsPageData, type MetaData } from '@/lib/types';
const data = await loadDerivedJson<AmountsPageData>('amounts.json', EMPTY_AMOUNTS_PAGE);
const meta = await loadDerivedJson<MetaData>('meta.json', EMPTY_META);
---
<BaseLayout title="Importes | Contratos de Vigo" titleGl="Importes | Contratos de Vigo" description="Distribución y contratos de mayor importe publicados por Vigo." descriptionGl="Distribución e contratos de maior importe publicados por Vigo.">
  <PageHero eyebrow="Análisis económico" eyebrowGl="Análise económica" title="Cómo se distribuyen los importes" titleGl="Como se distribúen os importes" copy="Percentiles, tramos y contratos destacados para distinguir la contratación habitual de los valores extremos." copyGl="Percentís, tramos e contratos destacados para distinguir a contratación habitual dos valores extremos." />
  <YearlyAnalysis client:load section="amounts" initial={data} meta={meta} />
</BaseLayout>
