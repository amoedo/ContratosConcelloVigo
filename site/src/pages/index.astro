---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { CivicDashboard } from '@/components/dashboard/CivicDashboard';
import { loadDerivedJson } from '@/lib/loadData';
import { EMPTY_DASHBOARD, EMPTY_META, type DashboardData, type MetaData } from '@/lib/types';

const dashboard = await loadDerivedJson<DashboardData>('dashboard.json', EMPTY_DASHBOARD);
const meta = await loadDerivedJson<MetaData>('meta.json', EMPTY_META);
---
<BaseLayout title="Contratos abiertos de Vigo" description="Explora y verifica la contratación menor publicada por el Concello de Vigo desde 2019." titleGl="Contratos abertos de Vigo" descriptionGl="Explora e verifica a contratación menor publicada polo Concello de Vigo desde 2019.">
  <CivicDashboard client:load initial={dashboard} meta={meta} />
</BaseLayout>
