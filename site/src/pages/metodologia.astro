---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { MethodologyPage } from '@/components/methodology/MethodologyPage';
import { loadDerivedJson } from '@/lib/loadData';
import { EMPTY_META, type MetaData } from '@/lib/types';

const meta = await loadDerivedJson<MetaData>('meta.json', EMPTY_META);
---
<BaseLayout title="Metodología | Contratos menores de Vigo" titleGl="Metodoloxía | Contratos menores de Vigo" description="Origen, reglas, límites legales y criterios del análisis." descriptionGl="Orixe, regras, límites legais e criterios da análise.">
  <MethodologyPage client:load meta={meta} />
</BaseLayout>
