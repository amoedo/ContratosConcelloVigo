---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import { PatternsExplorer } from '@/components/patterns/PatternsExplorer';
import { loadDerivedJson } from '@/lib/loadData';
import { EMPTY_PATTERNS_PAGE, type PatternsPageData } from '@/lib/types';

const data = await loadDerivedJson<PatternsPageData>('patterns.json', EMPTY_PATTERNS_PAGE);
---
<BaseLayout title="Patrones y alertas | Contratos menores de Vigo" titleGl="Patróns e alertas | Contratos menores de Vigo" description="Señales automáticas explicables y evidencia para revisar." descriptionGl="Sinais automáticos explicables e evidencia para revisar.">
  <PageHero eyebrow="Patrones y alertas" eyebrowGl="Patróns e alertas" title="Casos a revisar con reglas explícitas" titleGl="Casos para revisar con regras explícitas" copy="Las señales orientan una revisión y enlazan a su evidencia; no demuestran una irregularidad." copyGl="Os sinais orientan unha revisión e ligan coa súa evidencia; non demostran unha irregularidade." />
  <PatternsExplorer client:load data={data} />
</BaseLayout>
