---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import { YearlyAnalysis } from '@/components/sections/YearlyAnalysis';
import { loadDerivedJson } from '@/lib/loadData';
import { EMPTY_META, EMPTY_TOPICS_PAGE, type MetaData, type TopicsPageData } from '@/lib/types';
const data = await loadDerivedJson<TopicsPageData>('topics.json', EMPTY_TOPICS_PAGE);
const meta = await loadDerivedJson<MetaData>('meta.json', EMPTY_META);
---
<BaseLayout title="Temas | Contratos de Vigo" titleGl="Temas | Contratos de Vigo" description="Temas recurrentes en los asuntos de los contratos menores de Vigo." descriptionGl="Temas recorrentes nos asuntos dos contratos menores de Vigo.">
  <PageHero eyebrow="Temas y asuntos" eyebrowGl="Temas e asuntos" title="Qué necesidades aparecen de forma recurrente" titleGl="Que necesidades aparecen de forma recorrente" copy="Una taxonomía explicable ayuda a pasar del texto libre a categorías comparables y enlazadas con sus registros." copyGl="Unha taxonomía explicable axuda a pasar do texto libre a categorías comparables e ligadas cos seus rexistros." />
  <YearlyAnalysis client:load section="topics" initial={data} meta={meta} />
</BaseLayout>
