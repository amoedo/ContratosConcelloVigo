---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import { YearlyAnalysis } from '@/components/sections/YearlyAnalysis';
import { loadDerivedJson } from '@/lib/loadData';
import { EMPTY_META, EMPTY_UNITS_PAGE, type MetaData, type UnitsPageData } from '@/lib/types';
const data = await loadDerivedJson<UnitsPageData>('units.json', EMPTY_UNITS_PAGE);
const meta = await loadDerivedJson<MetaData>('meta.json', EMPTY_META);
---
<BaseLayout title="Unidades | Contratos de Vigo" titleGl="Unidades | Contratos de Vigo" description="Gasto y actividad de las unidades municipales de Vigo." descriptionGl="Gasto e actividade das unidades municipais de Vigo.">
  <PageHero eyebrow="Unidades municipales" eyebrowGl="Unidades municipais" title="Qué áreas contratan más y con quién" titleGl="Que áreas contratan máis e con quen" copy="Compara el volumen, el importe y los proveedores de cada unidad en la serie completa o en un ejercicio concreto." copyGl="Compara o volume, o importe e os provedores de cada unidade na serie completa ou nun exercicio concreto." />
  <YearlyAnalysis client:load section="units" initial={data} meta={meta} />
</BaseLayout>
